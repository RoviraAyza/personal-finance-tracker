# Copy to .env and edit. Nothing here is read automatically yet; these are
# plain environment variables, documented so you know they exist.

# Where the SQLite database lives.
#
# IMPORTANT: keep this OUT of this repository. The project folder is inside
# Google Drive, and Drive syncs files while they are open, which corrupts
# SQLite databases. The default below is outside any synced folder.
#
# PF_DB_PATH=C:\Users\rovir\AppData\Local\PersonalFinance\finance.db

# Path to a real bank export. Only needed to run the opt-in acceptance tests
# that check the parser against real data:
#
#     python -m pytest -m realdata
#
# Leave unset and those tests skip, so the suite is green on any machine.
#
# PF_REAL_XLS=C:\Users\rovir\Downloads\TT120926.075.XLS
